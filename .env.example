# Copie ce fichier en ".env" puis remplis avec les valeurs de ta console Firebase
# (Paramètres du projet > Général > Tes applications > Application Web)
# Sans ces valeurs, l'app marche en mode test : données gardées seulement sur l'appareil.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Pour les notifications push (Project Settings > Cloud Messaging > Web Push certificates > Generate key pair)
VITE_FIREBASE_VAPID_KEY=
